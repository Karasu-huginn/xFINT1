# Copying this file to .env is OPTIONAL. docker-compose.yml already declares every
# variable below with this exact default, so the stack runs with no .env at all.
# Create one only to override a value; Compose reads it automatically.

# PostgreSQL container credentials
POSTGRES_USER=xfint1
POSTGRES_PASSWORD=change_me
POSTGRES_DB=xfint1

# SQLAlchemy connection strings (host "db" is the compose service name)
DATABASE_URL=postgresql+psycopg://xfint1:change_me@db:5432/xfint1
TEST_DATABASE_URL=postgresql+psycopg://xfint1:change_me@db:5432/xfint1_test

# Development placeholder. Generate a real one before any real deployment:
#   openssl rand -hex 32
SECRET_KEY=dev_only_change_me_not_a_real_secret
ACCESS_TOKEN_EXPIRE_HOURS=8
ACTIVATION_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false

# Uploads
UPLOAD_DIR=/uploads
MAX_UPLOAD_SIZE_MB=5
MAX_FILES_PER_REPORT=10

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Mandatory grader account required by the brief
SEED_MANAGER_EMAIL=manager@supherman.com
SEED_MANAGER_PASSWORD=Suph3rm4n!
